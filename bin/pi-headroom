#!/usr/bin/env bash
set -euo pipefail

port="${PI_HEADROOM_PORT:-8787}"
proxy_url="http://127.0.0.1:$port"

healthy() { curl --silent --fail --max-time 2 "$proxy_url/health" >/dev/null; }

if ! healthy; then
  mkdir -p "$HOME/.headroom/logs"
  echo "pi-headroom: starting Headroom proxy..." >&2
  nohup headroom proxy --host 127.0.0.1 --port "$port" \
    >>"$HOME/.headroom/logs/pi-headroom.log" 2>&1 &
  for _ in {1..240}; do healthy && break; sleep 1; done
  if ! healthy; then
    echo "pi-headroom: proxy did not become healthy within 240s; see ~/.headroom/logs/pi-headroom.log" >&2
    exit 1
  fi
fi

PI_HEADROOM=1 PI_HEADROOM_URL="$proxy_url" exec pi "$@"
